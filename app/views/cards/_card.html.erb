<div id="<%= dom_id(card) %>"
     class="bg-white rounded-lg shadow-sm p-3 cursor-move hover:shadow-md transition-shadow"
     data-controller="card"
     data-card-id-value="<%= card.id %>"
     data-sortable-id="<%= card.id %>">
  <div class="flex items-start justify-between">
    <div class="flex-1 min-w-0">
      <!-- Card Title -->
      <div data-card-target="display">
        <p class="text-sm text-gray-900 font-medium cursor-pointer hover:text-indigo-600"
           data-action="click->card#showModal">
          <%= card.title %>
        </p>
      </div>

      <!-- Card Meta -->
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <% if card.priority.present? && card.priority != "no_priority" %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                       <%= case card.priority
                           when 'high' then 'bg-red-100 text-red-800'
                           when 'medium' then 'bg-yellow-100 text-yellow-800'
                           when 'low' then 'bg-green-100 text-green-800'
                           end %>">
            <%= card.priority.capitalize %>
          </span>
        <% end %>

        <% if card.due_date.present? %>
          <span class="inline-flex items-center text-xs
                       <%= if card.overdue?
                             'text-red-600'
                           elsif card.due_soon?
                             'text-yellow-600'
                           else
                             'text-gray-500'
                           end %>">
            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <%= card.due_date.strftime("%b %d") %>
          </span>
        <% end %>

        <% if card.description.present? %>
          <span class="text-gray-400">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
            </svg>
          </span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Card Modal -->
<div data-card-target="modal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     aria-labelledby="modal-title"
     role="dialog"
     aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
         data-action="click->card#hideModal"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>

    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <%= form_with model: [card.board, card.column, card],
                    data: { action: "turbo:submit-end->card#hideModal" },
                    class: "p-6" do |f| %>
        <div class="flex items-start justify-between mb-4">
          <h3 class="text-lg font-medium text-gray-900">Edit Card</h3>
          <button type="button" data-action="click->card#hideModal" class="text-gray-400 hover:text-gray-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :title,
                required: true,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>

          <div>
            <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_area :description,
                rows: 3,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :due_date, class: "block text-sm font-medium text-gray-700" %>
              <%= f.date_field :due_date,
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>

            <div>
              <%= f.label :priority, class: "block text-sm font-medium text-gray-700" %>
              <%= f.select :priority,
                  options_for_select([["None", "no_priority"], ["Low", "low"], ["Medium", "medium"], ["High", "high"]], card.priority),
                  {},
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between">
          <%= button_to "Delete",
                        board_column_card_path(card.board, card.column, card),
                        method: :delete,
                        data: { turbo_confirm: "Delete this card?" },
                        class: "text-sm text-red-600 hover:text-red-800" %>

          <div class="flex items-center space-x-3">
            <button type="button"
                    data-action="click->card#hideModal"
                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
              Cancel
            </button>
            <%= f.submit "Save Changes",
                class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md hover:bg-indigo-700 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
