<%= turbo_frame_tag dom_id(column), class: "flex-shrink-0 w-80" do %>
  <div class="bg-gray-200 rounded-lg p-3 h-full flex flex-col"
       data-controller="column"
       data-column-id-value="<%= column.id %>"
       data-column-board-id-value="<%= column.board_id %>">
    <!-- Column Header -->
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center flex-1 min-w-0" data-column-target="header">
        <h3 class="font-semibold text-gray-700 truncate cursor-pointer hover:text-gray-900"
            data-action="dblclick->column#startEditing">
          <%= column.name %>
        </h3>
        <span class="ml-2 text-xs text-gray-500 bg-gray-300 px-2 py-0.5 rounded-full">
          <%= column.cards.count %>
        </span>
      </div>

      <!-- Edit Form (hidden) -->
      <div data-column-target="editForm" class="hidden flex-1">
        <%= form_with model: [column.board, column],
                      class: "flex items-center space-x-2",
                      data: { action: "turbo:submit-end->column#stopEditing" } do |f| %>
          <%= f.text_field :name,
              value: column.name,
              required: true,
              data: { column_target: "nameInput", action: "keydown.escape->column#stopEditing" },
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
          <%= f.submit "Save", class: "sr-only" %>
        <% end %>
      </div>

      <div class="flex items-center space-x-1 ml-2">
        <button type="button"
                data-action="click->column#startEditing"
                class="p-1 text-gray-400 hover:text-gray-600 rounded">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        </button>
        <%= button_to board_column_path(column.board, column),
                      method: :delete,
                      data: { turbo_confirm: "Delete this column and all its cards?" },
                      class: "p-1 text-gray-400 hover:text-red-600 rounded" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        <% end %>
      </div>
    </div>

    <!-- Cards Container -->
    <div id="<%= dom_id(column, :cards) %>"
         class="flex-1 overflow-y-auto space-y-2 min-h-[100px]"
         data-controller="sortable"
         data-sortable-group-value="cards"
         data-sortable-url-value="<%= move_board_column_card_path(column.board, column, ':id') %>"
         data-column-target="cardsContainer">
      <% column.cards.each do |card| %>
        <%= render partial: "cards/card", locals: { card: card } %>
      <% end %>
    </div>

    <!-- Add Card Button/Form -->
    <div class="mt-3">
      <button type="button"
              data-action="click->column#showAddCard"
              data-column-target="addCardButton"
              class="w-full py-2 px-3 text-left text-sm text-gray-500 hover:bg-gray-300 rounded transition-colors">
        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add card
      </button>

      <div data-column-target="addCardForm" class="hidden">
        <%= form_with url: board_column_cards_path(column.board, column),
                      class: "bg-white rounded-lg shadow p-3",
                      data: { action: "turbo:submit-end->column#hideAddCard" } do |f| %>
          <%= f.text_area :title,
              placeholder: "Enter card title...",
              required: true,
              rows: 2,
              data: { action: "keydown.escape->column#hideAddCard keydown.enter->column#submitCard" },
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm resize-none" %>
          <div class="mt-2 flex items-center space-x-2">
            <%= f.submit "Add Card", class: "inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
            <button type="button"
                    data-action="click->column#hideAddCard"
                    class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              Cancel
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
