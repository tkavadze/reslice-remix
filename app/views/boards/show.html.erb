<div class="h-screen flex flex-col bg-gray-100">
  <!-- Header -->
  <div class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-4">
        <div class="flex items-center space-x-4">
          <%= link_to boards_path, class: "text-gray-500 hover:text-gray-700" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          <% end %>
          <h1 class="text-2xl font-bold text-gray-900"><%= @board.title %></h1>
          <% if @board.description.present? %>
            <span class="text-sm text-gray-500">- <%= @board.description %></span>
          <% end %>
        </div>
        <div class="flex items-center space-x-3">
          <%= link_to edit_board_path(@board), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Edit
          <% end %>
          <%= button_to board_path(@board), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this board?" }, class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Kanban Board -->
  <div class="flex-1 overflow-x-auto p-6" data-controller="board" data-board-id-value="<%= @board.id %>">
    <div class="flex space-x-4 h-full" data-board-target="columnsContainer">
      <% @columns.each do |column| %>
        <%= render partial: "columns/column", locals: { column: column } %>
      <% end %>

      <!-- Add Column Button -->
      <div id="add-column-container" class="flex-shrink-0 w-80">
        <button type="button"
                data-action="click->board#showAddColumn"
                data-board-target="addColumnButton"
                class="w-full py-3 px-4 border-2 border-dashed border-gray-300 rounded-lg text-sm font-medium text-gray-500 hover:border-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
          <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Column
        </button>

        <!-- Add Column Form (hidden by default) -->
        <%= turbo_frame_tag "new_column" do %>
          <div data-board-target="addColumnForm" class="hidden">
            <%= form_with url: board_columns_path(@board),
                          class: "bg-white rounded-lg shadow p-4",
                          data: { action: "turbo:submit-end->board#hideAddColumn" } do |f| %>
              <%= f.text_field :name,
                  placeholder: "Enter column name...",
                  required: true,
                  autofocus: true,
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              <div class="mt-3 flex items-center space-x-2">
                <%= f.submit "Add Column", class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
                <button type="button"
                        data-action="click->board#hideAddColumn"
                        class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
