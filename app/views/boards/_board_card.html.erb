<%= turbo_frame_tag dom_id(board) do %>
  <%= link_to board, class: "block bg-white rounded-lg shadow hover:shadow-md transition-shadow duration-200 overflow-hidden" do %>
    <div class="p-6">
      <h3 class="text-lg font-semibold text-gray-900 truncate"><%= board.title %></h3>
      <% if board.description.present? %>
        <p class="mt-2 text-sm text-gray-500 line-clamp-2"><%= board.description %></p>
      <% end %>
      <div class="mt-4 flex items-center text-xs text-gray-400">
        <span><%= board.columns.count %> columns</span>
        <span class="mx-2">&middot;</span>
        <span><%= board.cards.count %> cards</span>
      </div>
    </div>
  <% end %>
<% end %>
